# Auto detect text files and perform LF normalization
* text=auto

# Executáveis passam de 100 MB (limite do GitHub para arquivos comuns): vão pelo Git LFS.
*.exe filter=lfs diff=lfs merge=lfs -text
*.otf binary
*.png binary

# O gradlew do Android roda em sh: quebras de linha do Unix
mobile/android/gradlew text eol=lf
