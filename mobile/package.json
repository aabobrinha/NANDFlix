{
  "name": "nandflix-celular",
  "version": "1.0.8",
  "private": true,
  "description": "NANDFlix para Android: a mesma interface do app de PC, com os dados no celular e sincronizados pelo Supabase.",
  "scripts": {
    "montar": "node montar.js",
    "apk": "node montar.js && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "testar": "node montar.js && node testar.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-updater": "^8.54.0",
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "adm-zip": "^0.6.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "path-browserify": "^1.0.1"
  }
}
